{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webpush-proxy",
  "main": "ClaudflareWorkersWebpush.js",
  "compatibility_date": "2026-11-09",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  }
}
